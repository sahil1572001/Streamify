# Local PostgreSQL Configuration (used if AWS RDS not configured)
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=streamify
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# AWS RDS Configuration (optional - overrides local if provided)
# Uncomment and fill these to use AWS RDS instead of local PostgreSQL
# AWS_RDS_ENDPOINT=your-rds-endpoint.region.rds.amazonaws.com
# AWS_RDS_PORT=5432
# AWS_RDS_DATABASE=streamify
# AWS_RDS_USERNAME=streamify_admin
# AWS_RDS_PASSWORD=your_strong_password

# TMDB API Configuration (required for loading movie/TV data)
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=en-US

# JWT Authentication Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration (optional - for future features)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Pinecone Configuration (for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=streamify-movies

# OpenAI Configuration (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536
