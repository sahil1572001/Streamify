[Unit]
Description=Streamify FastAPI Backend
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/streamify/backend
Environment="PATH=/var/www/streamify/backend/venv/bin"
EnvironmentFile=/var/www/streamify/backend/.env
ExecStart=/var/www/streamify/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
